<Window x:Class="classique.timetabler.Dialogs.SolverProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:classique.timetabler.Controls"
        Title="Generating Timetable" 
        Height="600" Width="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        MinHeight="400" MinWidth="600"
        ShowInTaskbar="False">
    <Grid>
        <!-- Progress View -->
        <Grid x:Name="ProgressView" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Status Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,15">
                <TextBlock x:Name="StatusText" Text="Initializing solver..." FontSize="16" FontWeight="SemiBold"/>
                <ProgressBar x:Name="ProgressBar" Height="8" Margin="0,10,0,0" IsIndeterminate="True"/>
            </StackPanel>

            <!-- Statistics Summary -->
            <Border Grid.Row="1" Background="#F5F5F5" CornerRadius="5" Padding="15" Margin="0,0,0,15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Classes to Schedule:" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ClassCountText" Text="-"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Total Alternatives:" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" x:Name="AlternativesCountText" Text="-" Margin="0,5,0,0"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Constraint Variables:" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" x:Name="VariablesCountText" Text="-" Margin="0,5,0,0"/>

                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Elapsed Time:" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    <TextBlock Grid.Row="3" Grid.Column="1" x:Name="ElapsedTimeText" Text="-" Margin="0,5,0,0"/>
                </Grid>
            </Border>

            <!-- Log Output -->
            <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="5">
                <ScrollViewer x:Name="LogScrollViewer" VerticalScrollBarVisibility="Auto">
                    <TextBox x:Name="LogTextBox" 
                             IsReadOnly="True" 
                             TextWrapping="Wrap" 
                             BorderThickness="0"
                             FontFamily="Consolas"
                             FontSize="12"
                             Background="White"
                             Padding="10"/>
                </ScrollViewer>
            </Border>

            <!-- Buttons -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                <Button x:Name="CancelButton" Content="Cancel" Width="100" Height="30" Click="CancelButton_Click"/>
                <Button x:Name="ViewResultsButton" Content="View Results" Width="120" Height="30" Margin="10,0,0,0" 
                        Click="ViewResultsButton_Click" Visibility="Collapsed"/>
                <Button x:Name="CloseButton" Content="Close" Width="100" Height="30" Margin="10,0,0,0" 
                        Click="CloseButton_Click" Visibility="Collapsed"/>
            </StackPanel>
        </Grid>

        <!-- Results View -->
        <Grid x:Name="ResultsView" Margin="20" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Margin="0,0,0,15">
                <TextBlock x:Name="ResultsHeaderText" Text="Schedule Results" FontSize="16" FontWeight="SemiBold"/>
                <TextBlock x:Name="ResultsSubText" Text="" Foreground="#666" Margin="0,5,0,0"/>
            </StackPanel>

            <!-- Results Content -->
            <controls:ScheduleResultsView x:Name="ScheduleResultsControl" Grid.Row="1"/>

            <!-- Buttons -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                <Button x:Name="BackToLogButton" Content="Back to Log" Width="120" Height="30" Click="BackToLogButton_Click"/>
                <Button x:Name="AcceptButton" Content="Accept" Width="100" Height="30" Margin="10,0,0,0" Click="AcceptButton_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
