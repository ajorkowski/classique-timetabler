<UserControl x:Class="classique.timetabler.Controls.TimeOnlyPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d"
             x:Name="Root">
    <StackPanel Orientation="Horizontal">
        <ComboBox x:Name="HourComboBox" 
                  Width="45" 
                  SelectionChanged="Time_SelectionChanged"/>
        <TextBlock Text=":" VerticalAlignment="Center" Margin="2,0"/>
        <ComboBox x:Name="MinuteComboBox" 
                  Width="45" 
                  SelectionChanged="Time_SelectionChanged"/>
        <ComboBox x:Name="AmPmComboBox" 
                  Width="50" 
                  Margin="5,0,0,0"
                  SelectionChanged="Time_SelectionChanged">
            <ComboBoxItem Content="AM"/>
            <ComboBoxItem Content="PM"/>
        </ComboBox>
    </StackPanel>
</UserControl>
