<UserControl x:Class="classique.timetabler.Controls.ScheduleResultsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:classique.timetabler.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <local:NullToCollapsedConverter x:Key="NullToCollapsedConverter"/>
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- View Mode Selector -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="View by:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <ComboBox x:Name="ViewModeComboBox" Width="150" SelectionChanged="ViewModeComboBox_SelectionChanged">
                <ComboBoxItem Content="Day" IsSelected="True"/>
                <ComboBoxItem Content="Teacher"/>
                <ComboBoxItem Content="Studio"/>
                <ComboBoxItem Content="Student"/>
            </ComboBox>
            
            <!-- Filter for Student view -->
            <TextBlock x:Name="StudentFilterLabel" Text="Student:" VerticalAlignment="Center" Margin="20,0,10,0" Visibility="Collapsed"/>
            <ComboBox x:Name="StudentFilterComboBox" Width="200" Visibility="Collapsed" SelectionChanged="StudentFilterComboBox_SelectionChanged"/>
        </StackPanel>

        <!-- Summary Stats -->
        <Border Grid.Row="1" Background="#F0F7FF" BorderBrush="#B8D4FF" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="SummaryText" Text="0 classes scheduled" FontWeight="SemiBold"/>
                <TextBlock Text=" | " Foreground="#888"/>
                <TextBlock x:Name="GroupsCountText" Text="0 groups"/>
                <TextBlock Text=" | " Foreground="#888"/>
                <TextBlock x:Name="SolosCountText" Text="0 solos"/>
            </StackPanel>
        </Border>

        <!-- Schedule Grid -->
        <Border Grid.Row="2" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="5">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <ItemsControl x:Name="ScheduleItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="10">
                                <StackPanel>
                                    <!-- Group Header -->
                                    <TextBlock Text="{Binding GroupHeader}" FontWeight="Bold" FontSize="16" Foreground="#2C5282" Margin="0,0,0,10"/>
                                    
                                    <!-- SubGroups -->
                                    <ItemsControl ItemsSource="{Binding SubGroups}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,10">
                                                    <!-- SubGroup Header (if present) -->
                                                    <TextBlock Text="{Binding SubGroupHeader}" 
                                                               FontWeight="SemiBold" 
                                                               FontSize="13" 
                                                               Foreground="#4A5568" 
                                                               Margin="10,0,0,5"
                                                               Visibility="{Binding SubGroupHeader, Converter={StaticResource NullToCollapsedConverter}}"/>
                                                    
                                                    <!-- Classes in this subgroup -->
                                                    <ItemsControl ItemsSource="{Binding Classes}" Margin="10,0,0,0">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Background="White" BorderBrush="#DDD" BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,2">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="90"/>
                                                                            <ColumnDefinition Width="*"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                            <ColumnDefinition Width="Auto"/>
                                                                        </Grid.ColumnDefinitions>
                                                                        
                                                                        <!-- Time -->
                                                                        <TextBlock Grid.Column="0" Text="{Binding TimeRange}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                                        
                                                                        <!-- Class Name -->
                                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                                                            <TextBlock Text="{Binding ClassName}" FontWeight="SemiBold"/>
                                                                            <TextBlock Text="{Binding StudentNames}" Foreground="#666" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                                                        </StackPanel>
                                                                        
                                                                        <!-- Teacher (if shown) -->
                                                                        <TextBlock Grid.Column="2" Text="{Binding TeacherName}" Foreground="#555" VerticalAlignment="Center" Margin="0,0,15,0"
                                                                                   Visibility="{Binding TeacherName, Converter={StaticResource NullToCollapsedConverter}}"/>
                                                                        
                                                                        <!-- Studio (if shown) -->
                                                                        <TextBlock Grid.Column="3" Text="{Binding StudioName}" Foreground="#555" VerticalAlignment="Center" MinWidth="100"
                                                                                   Visibility="{Binding StudioName, Converter={StaticResource NullToCollapsedConverter}}"/>
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
