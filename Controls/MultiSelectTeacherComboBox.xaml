<UserControl x:Class="classique.timetabler.Controls.MultiSelectTeacherComboBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:classique.timetabler.Controls"
             mc:Ignorable="d"
             x:Name="Root">
    <Grid>
        <Button x:Name="DropDownButton" 
                Click="DropDownButton_Click"
                HorizontalContentAlignment="Left"
                Padding="5,2">
            <TextBlock x:Name="DisplayText" Text="Select teachers..."/>
            <Button.ContextMenu>
                <ContextMenu x:Name="TeacherMenu">
                    <ContextMenu.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header" Value="{Binding Teacher.Name}"/>
                            <Setter Property="IsCheckable" Value="True"/>
                            <Setter Property="IsChecked" Value="{Binding IsSelected, Mode=TwoWay}"/>
                            <Setter Property="StaysOpenOnClick" Value="True"/>
                        </Style>
                    </ContextMenu.ItemContainerStyle>
                </ContextMenu>
            </Button.ContextMenu>
        </Button>
    </Grid>
</UserControl>
