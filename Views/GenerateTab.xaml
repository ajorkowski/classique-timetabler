<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:views="clr-namespace:ClassiqueTimetabler.Maui.Views"
             x:Class="ClassiqueTimetabler.Maui.Views.GenerateTab">
    <Grid Margin="10">
        <!-- ==================== SETUP VIEW ==================== -->
        <Grid x:Name="SetupView">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Label Text="Generate Timetable" 
                   FontSize="24" 
                   Margin="0,0,0,20"/>

            <ScrollView Grid.Row="1">
                <VerticalStackLayout Spacing="20">
                    <!-- Summary Section -->
                    <Label Text="Summary" FontSize="18" FontAttributes="Bold"/>

                    <Border BackgroundColor="#F5F5F5" 
                            Stroke="#E0E0E0"
                            StrokeShape="RoundRectangle 8"
                            Padding="15">
                        <Grid ColumnSpacing="20" RowSpacing="15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <VerticalStackLayout Grid.Column="0" Grid.Row="0">
                                <Label Text="Studios" FontAttributes="Bold" TextColor="#555"/>
                                <Label x:Name="StudiosCountLabel" FontSize="24" TextColor="{StaticResource Primary}"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Grid.Row="0">
                                <Label Text="Teachers" FontAttributes="Bold" TextColor="#555"/>
                                <Label x:Name="TeachersCountLabel" FontSize="24" TextColor="{StaticResource Primary}"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="2" Grid.Row="0">
                                <Label Text="Students" FontAttributes="Bold" TextColor="#555"/>
                                <Label x:Name="StudentsCountLabel" FontSize="24" TextColor="{StaticResource Primary}"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="0" Grid.Row="1">
                                <Label Text="Groups" FontAttributes="Bold" TextColor="#555"/>
                                <Label x:Name="GroupsCountLabel" FontSize="24" TextColor="{StaticResource Primary}"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Grid.Row="1">
                                <Label Text="Solos" FontAttributes="Bold" TextColor="#555"/>
                                <Label x:Name="SolosCountLabel" FontSize="24" TextColor="{StaticResource Primary}"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="2" Grid.Row="1">
                                <Label Text="Total Duration" FontAttributes="Bold" TextColor="#555"/>
                                <Label x:Name="TotalDurationLabel" FontSize="24" TextColor="{StaticResource Primary}"/>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Optimization Weights Section -->
                    <Label Text="Optimization Weights" FontSize="18" FontAttributes="Bold"/>

                    <Border BackgroundColor="#F5F5F5" 
                            Stroke="#E0E0E0"
                            StrokeShape="RoundRectangle 8"
                            Padding="15">
                        <Grid ColumnSpacing="20" RowSpacing="15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <VerticalStackLayout Grid.Column="0" Grid.Row="0">
                                <Label Text="α (Alpha) - Makespan" FontAttributes="Bold" TextColor="#555"/>
                                <Label Text="Prioritize finishing all classes early" TextColor="#888" FontSize="11"/>
                                <Border Stroke="#E0E0E0" StrokeShape="RoundRectangle 4" Padding="8,0" WidthRequest="120" HorizontalOptions="Start" Margin="0,5,0,0">
                                    <Entry x:Name="AlphaEntry" Keyboard="Numeric" TextChanged="WeightEntry_TextChanged"/>
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Grid.Row="0">
                                <Label Text="β (Beta) - Student Clustering" FontAttributes="Bold" TextColor="#555"/>
                                <Label Text="Minimize gaps between student's classes" TextColor="#888" FontSize="11"/>
                                <Border Stroke="#E0E0E0" StrokeShape="RoundRectangle 4" Padding="8,0" WidthRequest="120" HorizontalOptions="Start" Margin="0,5,0,0">
                                    <Entry x:Name="BetaEntry" Keyboard="Numeric" TextChanged="WeightEntry_TextChanged"/>
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="0" Grid.Row="1">
                                <Label Text="γ (Gamma) - Age Priority" FontAttributes="Bold" TextColor="#555"/>
                                <Label Text="Schedule younger students earlier in day" TextColor="#888" FontSize="11"/>
                                <Border Stroke="#E0E0E0" StrokeShape="RoundRectangle 4" Padding="8,0" WidthRequest="120" HorizontalOptions="Start" Margin="0,5,0,0">
                                    <Entry x:Name="GammaEntry" Keyboard="Numeric" TextChanged="WeightEntry_TextChanged"/>
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" Grid.Row="1">
                                <Label Text="W_cross - Cross-Day Penalty" FontAttributes="Bold" TextColor="#555"/>
                                <Label Text="Penalty (minutes) for classes on different days" TextColor="#888" FontSize="11"/>
                                <Border Stroke="#E0E0E0" StrokeShape="RoundRectangle 4" Padding="8,0" WidthRequest="120" HorizontalOptions="Start" Margin="0,5,0,0">
                                    <Entry x:Name="CrossDayEntry" Keyboard="Numeric" TextChanged="WeightEntry_TextChanged"/>
                                </Border>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Warnings Section -->
                    <Label Text="Warnings" FontSize="18" FontAttributes="Bold"/>

                    <Border x:Name="NoWarningsPanel" 
                            BackgroundColor="#D4EDDA" 
                            Stroke="#C3E6CB"
                            StrokeShape="RoundRectangle 8"
                            Padding="15">
                        <HorizontalStackLayout>
                            <Label Text="✓ " TextColor="#155724" FontAttributes="Bold" FontSize="16"/>
                            <Label Text="No warnings. Ready to generate timetable." TextColor="#155724"/>
                        </HorizontalStackLayout>
                    </Border>

                    <Border x:Name="WarningsPanel" 
                            BackgroundColor="#FFF3CD" 
                            Stroke="#FFE69C"
                            StrokeShape="RoundRectangle 8"
                            Padding="15"
                            IsVisible="False">
                        <VerticalStackLayout Spacing="10">
                            <HorizontalStackLayout>
                                <Label Text="⚠ " TextColor="#856404" FontAttributes="Bold" FontSize="16"/>
                                <Label x:Name="WarningsCountLabel" TextColor="#856404" FontAttributes="Bold"/>
                            </HorizontalStackLayout>
                            <VerticalStackLayout x:Name="WarningsList" Spacing="5"/>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>

            <Button Grid.Row="2" 
                    x:Name="GenerateButton" 
                    Text="Generate Timetable" 
                    WidthRequest="200" 
                    HeightRequest="44"
                    HorizontalOptions="Center"
                    Margin="0,20,0,0"
                    Clicked="GenerateButton_Clicked"/>
        </Grid>

        <!-- ==================== PROGRESS VIEW ==================== -->
        <Grid x:Name="ProgressView" IsVisible="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <VerticalStackLayout Grid.Row="0" Margin="0,0,0,15">
                <Label x:Name="StatusLabel" Text="Initializing solver..." FontSize="18" FontAttributes="Bold"/>
                <ProgressBar x:Name="ProgressBar" HeightRequest="8" Margin="0,10,0,0" ProgressColor="{StaticResource Primary}"/>
            </VerticalStackLayout>

            <!-- Statistics -->
            <Border Grid.Row="1" 
                    BackgroundColor="#F5F5F5" 
                    StrokeShape="RoundRectangle 5" 
                    Padding="15" 
                    Margin="0,0,0,15">
                <Grid ColumnSpacing="20" RowSpacing="5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Label Grid.Row="0" Grid.Column="0" Text="Classes to Schedule:" FontAttributes="Bold"/>
                    <Label Grid.Row="0" Grid.Column="1" x:Name="ClassCountLabel" Text="-"/>

                    <Label Grid.Row="1" Grid.Column="0" Text="Total Alternatives:" FontAttributes="Bold"/>
                    <Label Grid.Row="1" Grid.Column="1" x:Name="AlternativesCountLabel" Text="-"/>

                    <Label Grid.Row="2" Grid.Column="0" Text="Constraint Variables:" FontAttributes="Bold"/>
                    <Label Grid.Row="2" Grid.Column="1" x:Name="VariablesCountLabel" Text="-"/>

                    <Label Grid.Row="3" Grid.Column="0" Text="Elapsed Time:" FontAttributes="Bold"/>
                    <Label Grid.Row="3" Grid.Column="1" x:Name="ElapsedTimeLabel" Text="-"/>
                </Grid>
            </Border>

            <!-- Log Output -->
            <Border Grid.Row="2" 
                    Stroke="#E0E0E0" 
                    StrokeThickness="1" 
                    StrokeShape="RoundRectangle 5">
                <ScrollView x:Name="LogScrollView">
                    <Editor x:Name="LogEditor" 
                            IsReadOnly="True"
                            FontFamily="Consolas"
                            FontSize="12"
                            BackgroundColor="White"/>
                </ScrollView>
            </Border>

            <!-- Buttons -->
            <HorizontalStackLayout Grid.Row="3" 
                                   HorizontalOptions="End" 
                                   Spacing="10" 
                                   Margin="0,15,0,0">
                <Button x:Name="CancelButton" 
                        Text="Cancel" 
                        WidthRequest="120" 
                        HeightRequest="40"
                        BackgroundColor="#6B7280"
                        Clicked="CancelButton_Clicked"/>
                <Button x:Name="ViewResultsButton" 
                        Text="View Results" 
                        WidthRequest="130" 
                        HeightRequest="40"
                        IsVisible="False"
                        Clicked="ViewResultsButton_Clicked"/>
                <Button x:Name="CloseProgressButton" 
                        Text="Back" 
                        WidthRequest="100" 
                        HeightRequest="40"
                        BackgroundColor="#6B7280"
                        IsVisible="False"
                        Clicked="CloseProgressButton_Clicked"/>
            </HorizontalStackLayout>
        </Grid>

        <!-- ==================== RESULTS VIEW ==================== -->
        <Grid x:Name="ResultsView" IsVisible="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <VerticalStackLayout Grid.Row="0" Margin="0,0,0,15">
                <Label x:Name="ResultsHeaderLabel" Text="Schedule Results" FontSize="20" FontAttributes="Bold"/>
                <Label x:Name="ResultsSubLabel" Text="" TextColor="#666666"/>
            </VerticalStackLayout>

            <!-- Schedule Preview -->
            <views:ScheduleResultsView x:Name="ResultsPreview" Grid.Row="1"/>

            <!-- Action Buttons -->
            <HorizontalStackLayout Grid.Row="2" 
                                   HorizontalOptions="End" 
                                   Spacing="10" 
                                   Margin="0,15,0,0">
                <Button x:Name="ViewLogButton" 
                        Text="View Log" 
                        WidthRequest="120" 
                        HeightRequest="40"
                        BackgroundColor="#6B7280"
                        Clicked="ViewLogButton_Clicked"/>
                <Button x:Name="RegenerateButton" 
                        Text="Regenerate" 
                        WidthRequest="120" 
                        HeightRequest="40"
                        BackgroundColor="#6B7280"
                        Clicked="RegenerateButton_Clicked"/>
                <Button x:Name="SaveToResultsButton" 
                        Text="Save to Results" 
                        WidthRequest="150" 
                        HeightRequest="40"
                        Clicked="SaveToResultsButton_Clicked"/>
            </HorizontalStackLayout>
        </Grid>
    </Grid>
</ContentView>
