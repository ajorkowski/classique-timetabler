<UserControl x:Class="classique.timetabler.Tabs.Results.ResultsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:classique.timetabler.Controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Schedule Results" 
                       FontSize="24" 
                       FontWeight="Light"/>
            <TextBlock x:Name="ResultsInfoText" 
                       Text="" 
                       Foreground="#666" 
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- No Results Message -->
        <Border x:Name="NoResultsPanel" 
                Grid.Row="1" 
                Background="#F5F5F5" 
                BorderBrush="#E0E0E0" 
                BorderThickness="1" 
                CornerRadius="5"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Padding="40">
            <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="No Schedule Generated" 
                           FontSize="18" 
                           FontWeight="SemiBold" 
                           HorizontalAlignment="Center"
                           Foreground="#666"/>
                <TextBlock Text="Go to the Generate tab to create a timetable." 
                           Foreground="#888" 
                           HorizontalAlignment="Center"
                           Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <!-- Results View -->
        <controls:ScheduleResultsView x:Name="ScheduleResultsControl" 
                                       Grid.Row="1" 
                                       Visibility="Collapsed"/>
    </Grid>
</UserControl>
