<UserControl x:Class="classique.timetabler.Tabs.Generate.GenerateTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:classique.timetabler.Tabs.Generate"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Generate Timetable" 
                   FontSize="24" 
                   FontWeight="Light" 
                   Margin="0,0,0,20"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Summary Section -->
                <TextBlock Text="Summary" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                
                <Border Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="1" Padding="15" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Row 1 -->
                        <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,0,15">
                            <TextBlock Text="Studios" FontWeight="SemiBold" Foreground="#555"/>
                            <TextBlock x:Name="StudiosCountText" FontSize="24" Foreground="#2C5282"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,0,0,15">
                            <TextBlock Text="Teachers" FontWeight="SemiBold" Foreground="#555"/>
                            <TextBlock x:Name="TeachersCountText" FontSize="24" Foreground="#2C5282"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Grid.Row="0" Margin="0,0,0,15">
                            <TextBlock Text="Students" FontWeight="SemiBold" Foreground="#555"/>
                            <TextBlock x:Name="StudentsCountText" FontSize="24" Foreground="#2C5282"/>
                        </StackPanel>

                        <!-- Row 2 -->
                        <StackPanel Grid.Column="0" Grid.Row="1">
                            <TextBlock Text="Groups" FontWeight="SemiBold" Foreground="#555"/>
                            <TextBlock x:Name="GroupsCountText" FontSize="24" Foreground="#2C5282"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Grid.Row="1">
                            <TextBlock Text="Solos" FontWeight="SemiBold" Foreground="#555"/>
                            <TextBlock x:Name="SolosCountText" FontSize="24" Foreground="#2C5282"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Grid.Row="1">
                            <TextBlock Text="Total Duration" FontWeight="SemiBold" Foreground="#555"/>
                            <TextBlock x:Name="TotalDurationText" FontSize="24" Foreground="#2C5282"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Optimization Weights Section -->
                <TextBlock Text="Optimization Weights" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                
                <Border Background="#F5F5F5" BorderBrush="#E0E0E0" BorderThickness="1" Padding="15" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Alpha - Makespan -->
                        <StackPanel Grid.Column="0" Grid.Row="0" Margin="0,0,15,15">
                            <TextBlock Text="&#945; (Alpha) - Makespan" FontWeight="SemiBold" Foreground="#555"/>
                            <TextBlock Text="Prioritize finishing all classes early" Foreground="#888" FontSize="11" Margin="0,0,0,5"/>
                            <TextBox x:Name="AlphaTextBox" Width="100" HorizontalAlignment="Left" TextChanged="WeightTextBox_TextChanged"/>
                        </StackPanel>

                        <!-- Beta - Student Clustering -->
                        <StackPanel Grid.Column="1" Grid.Row="0" Margin="0,0,0,15">
                            <TextBlock Text="&#946; (Beta) - Student Clustering" FontWeight="SemiBold" Foreground="#555"/>
                            <TextBlock Text="Minimize gaps between student's classes" Foreground="#888" FontSize="11" Margin="0,0,0,5"/>
                            <TextBox x:Name="BetaTextBox" Width="100" HorizontalAlignment="Left" TextChanged="WeightTextBox_TextChanged"/>
                        </StackPanel>

                        <!-- Gamma - Age Priority -->
                        <StackPanel Grid.Column="0" Grid.Row="1" Margin="0,0,15,0">
                            <TextBlock Text="&#947; (Gamma) - Age Priority" FontWeight="SemiBold" Foreground="#555"/>
                            <TextBlock Text="Schedule younger students earlier in day" Foreground="#888" FontSize="11" Margin="0,0,0,5"/>
                            <TextBox x:Name="GammaTextBox" Width="100" HorizontalAlignment="Left" TextChanged="WeightTextBox_TextChanged"/>
                        </StackPanel>

                        <!-- Cross-Day Penalty -->
                        <StackPanel Grid.Column="1" Grid.Row="1">
                            <TextBlock Text="W_cross - Cross-Day Penalty" FontWeight="SemiBold" Foreground="#555"/>
                            <TextBlock Text="Penalty (minutes) for classes on different days" Foreground="#888" FontSize="11" Margin="0,0,0,5"/>
                            <TextBox x:Name="CrossDayTextBox" Width="100" HorizontalAlignment="Left" TextChanged="WeightTextBox_TextChanged"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Warnings Section -->
                <TextBlock Text="Warnings" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,10"/>
                
                <Border x:Name="NoWarningsPanel" 
                        Background="#D4EDDA" 
                        BorderBrush="#C3E6CB" 
                        BorderThickness="1" 
                        Padding="15" 
                        Margin="0,0,0,20">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#10003; " Foreground="#155724" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Text="No warnings. Ready to generate timetable." Foreground="#155724"/>
                    </StackPanel>
                </Border>

                <Border x:Name="WarningsPanel" 
                        Background="#FFF3CD" 
                        BorderBrush="#FFE69C" 
                        BorderThickness="1" 
                        Padding="15" 
                        Margin="0,0,0,20"
                        Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <TextBlock Text="&#9888; " Foreground="#856404" FontWeight="Bold" FontSize="16"/>
                            <TextBlock x:Name="WarningsCountText" Foreground="#856404" FontWeight="SemiBold"/>
                        </StackPanel>
                        <ItemsControl x:Name="WarningsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="#856404" Margin="20,2,0,2" TextWrapping="Wrap"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Generate Button -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
            <Button x:Name="GenerateButton" 
                    Content="Generate Timetable" 
                    Width="200" 
                    Height="40"
                    FontSize="14"
                    Click="GenerateButton_Click"/>
        </StackPanel>
    </Grid>
</UserControl>
